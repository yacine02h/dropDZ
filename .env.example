# ===========================
# Page Watcher — Environment
# ===========================

# تشغيل المتصفح في وضع مخفي (true) أو مرئي (false) للتشخيص
HEADLESS=true

# المهلة القصوى بالمللي ثانية لانتظار ظهور العنصر
ELEMENT_TIMEOUT=15000

# المهلة القصوى بالمللي ثانية لتحميل الصفحة بالكامل
PAGE_TIMEOUT=30000

# مسار ملف حفظ اللقطات
SNAPSHOTS_PATH=./data/snapshots.json

# (اختياري) رابط Webhook لإرسال التنبيهات — اتركه فارغاً لتعطيل الإرسال
WEBHOOK_URL=
